#!/usr/bin/env python3
"""Open the Baddie's Casino floor from any folder -- what the `casino` shell
alias runs (see bin/install-aliases). It's `python3 -m casino` from the
repository root, without changing your folder: options and relative paths
mean where you are."""
import sys
from pathlib import Path

# This repository first on the path (the folder you're in isn't on it at all,
# so nothing there named casino or blackjack can be picked up instead).
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from casino.__main__ import main  # noqa: E402

main()
